@page
@model InsuranceClaimManagement.Pages.Staff.CreateModel
@{
    ViewData["Title"] = "Add staff account";
}

<h1>Add staff account</h1>

@if (Model.AccountCreated)
{
    <div class="alert alert-success">The staff account was created.</div>
    <div class="alert alert-warning">
        This link grants access to the account, expires in two hours, and should be shared privately.
        It is shown only on this page.
    </div>
    <div class="form-group">
        <label for="passwordSetupUrl">One-time password setup link</label>
        <textarea id="passwordSetupUrl" class="form-control" rows="4" readonly
                  onfocus="this.select()">@Model.PasswordSetupUrl</textarea>
    </div>
    <a asp-page="Index" class="btn btn-primary">Return to staff accounts</a>
}
else
{
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Input.DisplayName"></label>
        <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" />
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Role"></label>
        <select asp-for="Input.Role" asp-items="Model.RoleOptions" class="form-control">
            <option value="">Select a role</option>
        </select>
        <span asp-validation-for="Input.Role" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create account</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
