@page "{id:int}"
@model InsuranceClaimManagement.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete customer";
}

<h1>Delete customer</h1>

<h3>Are you sure you want to delete this customer?</h3>
@if (Model.RelatedClaimCount > 0)
{
    <div class="alert alert-warning">
        This customer cannot be deleted because @Model.RelatedClaimCount claim(s) are associated with it.
    </div>
}
<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Customer.Name</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Customer.Email</dd>

        <dt class="col-sm-2">Customer reference</dt>
        <dd class="col-sm-10">@Model.Customer.Username</dd>
    </dl>
</div>

<form method="post">
    @if (Model.RelatedClaimCount == 0)
    {
        <button type="submit" asp-route-id="@Model.Customer.Id" class="btn btn-danger">Delete</button>
    }
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
