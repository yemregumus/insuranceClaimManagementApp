@page
@model InsuranceClaimManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="text-center mb-4">Insurance Claim Management Dashboard</h1>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Customers</h2>
                <p class="display-4">@Model.CustomerCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">All claims</h2>
                <p class="display-4">@Model.ClaimCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Pending claims</h2>
                <p class="display-4">@Model.PendingClaimCount</p>
            </div>
        </div>
    </div>
</div>
