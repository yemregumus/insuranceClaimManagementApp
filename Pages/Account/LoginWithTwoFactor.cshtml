@page
@model InsuranceClaimManagement.Pages.Account.LoginWithTwoFactorModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<h1>Two-factor authentication</h1>
<p>Enter the current code from your authenticator app.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="RememberMe" type="hidden" />
    <input asp-for="ReturnUrl" type="hidden" />

    <div class="form-group">
        <label asp-for="Input.Code"></label>
        <input asp-for="Input.Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input asp-for="Input.RememberMachine" class="form-check-input" />
        <label asp-for="Input.RememberMachine" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Sign in</button>
    <a asp-page="LoginWithRecoveryCode"
       asp-route-returnUrl="@Model.ReturnUrl"
       asp-route-rememberMe="@Model.RememberMe"
       class="btn btn-link">Use a recovery code</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
