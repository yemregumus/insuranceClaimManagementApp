@page
@model InsuranceClaimManagement.Pages.Account.TwoFactorModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<h1>Two-factor authentication</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.NewRecoveryCodes != null)
{
    <div class="alert alert-warning">
        Save these recovery codes somewhere secure. They will not be shown again.
    </div>
    <div class="row mb-3">
        @foreach (var code in Model.NewRecoveryCodes)
        {
            <code class="col-sm-6">@code</code>
        }
    </div>
}

@if (Model.IsEnabled)
{
    <div class="alert alert-success">Two-factor authentication is enabled.</div>
    <p>Recovery codes remaining: @Model.RecoveryCodesRemaining</p>
    <form method="post" asp-page-handler="RecoveryCodes">
        <button type="submit" class="btn btn-outline-primary">Generate new recovery codes</button>
    </form>
}
else
{
    <p>Scan this QR code with your authenticator app, then enter the code it generates.</p>
    @if (!string.IsNullOrWhiteSpace(Model.QrCodeDataUri))
    {
        <div class="mb-3">
            <img src="@Model.QrCodeDataUri"
                 alt="QR code for setting up two-factor authentication"
                 width="264"
                 height="264"
                 class="img-fluid border p-2 bg-white" />
        </div>
    }

    <p>If you cannot scan the QR code, enter these values manually:</p>
    <dl class="row">
        <dt class="col-sm-3">Account</dt>
        <dd class="col-sm-9">@Model.AccountName</dd>
        <dt class="col-sm-3">Key</dt>
        <dd class="col-sm-9"><code>@Model.SharedKey</code></dd>
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">Time based (TOTP)</dd>
    </dl>

    <form method="post" asp-page-handler="Enable">
        <div class="form-group">
            <label asp-for="Input.VerificationCode"></label>
            <input asp-for="Input.VerificationCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
            <span asp-validation-for="Input.VerificationCode" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Verify and enable</button>
    </form>
}

<p class="mt-3"><a asp-page="ChangePassword">Change password</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
