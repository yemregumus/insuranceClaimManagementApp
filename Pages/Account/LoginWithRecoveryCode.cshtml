@page
@model InsuranceClaimManagement.Pages.Account.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
}

<h1>Use a recovery code</h1>
<p>Each recovery code can be used only once.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="RememberMe" type="hidden" />
    <input asp-for="ReturnUrl" type="hidden" />

    <div class="form-group">
        <label asp-for="Input.Code"></label>
        <input asp-for="Input.Code" class="form-control" autocomplete="one-time-code" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Sign in</button>
    <a asp-page="LoginWithTwoFactor"
       asp-route-returnUrl="@Model.ReturnUrl"
       asp-route-rememberMe="@Model.RememberMe"
       class="btn btn-link">Use an authenticator code</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
