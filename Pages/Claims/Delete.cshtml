@page "{id:int}"
@model InsuranceClaimManagement.Pages.Claims.DeleteModel
@{
    ViewData["Title"] = "Delete Claim";
}

<h1>Archive Claim</h1>

<h3>Are you sure you want to archive this claim?</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div>
    <h4>Claim</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Claim Type</dt>
        <dd class="col-sm-10">@Model.ClaimRecord.ClaimType</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.ClaimRecord.Description</dd>

        <dt class="col-sm-2">Policy Number</dt>
        <dd class="col-sm-10">@Model.ClaimRecord.PolicyNumber</dd>

        <dt class="col-sm-2">Claim Date</dt>
        <dd class="col-sm-10">@(Model.ClaimRecord.ClaimDate?.ToShortDateString() ?? "Not recorded")</dd>

        <dt class="col-sm-2">Amount</dt>
        <dd class="col-sm-10">@Model.ClaimRecord.Amount</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.ClaimRecord.Status</dd>

        <dt class="col-sm-2">Customer</dt>
        <dd class="col-sm-10">@(Model.ClaimRecord.User?.Name ?? $"Customer #{Model.ClaimRecord.UserId}")</dd>
    </dl>
</div>

<form method="post">
    <input asp-for="ConcurrencyToken" type="hidden" />
    <button type="submit" asp-route-id="@Model.ClaimRecord.Id" class="btn btn-danger">Archive</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
