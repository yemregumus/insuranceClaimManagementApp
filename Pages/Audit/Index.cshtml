@page
@model InsuranceClaimManagement.Pages.Audit.IndexModel
@{
    ViewData["Title"] = "Audit trail";
}

<h1>Audit trail</h1>
<p class="text-muted">The 200 most recent events for your organization. Times are shown in UTC.</p>

<table class="table">
    <thead>
        <tr>
            <th>When</th>
            <th>Staff member</th>
            <th>Event</th>
            <th>Record type</th>
            <th>Record ID</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var audit in Model.AuditEvents)
        {
            <tr>
                <td>@audit.OccurredUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@audit.ActorUser.DisplayName</td>
                <td>@audit.EventType</td>
                <td>@audit.EntityType</td>
                <td>@audit.EntityId</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.AuditEvents.Count == 0)
{
    <p>No audit events have been recorded yet.</p>
}
